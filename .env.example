# Copy to .env.local for local overrides, or set this in Vercel's Project
# Settings -> Environment Variables (Production, Preview, and Development
# can each point at a different backend if you have staging).
#
# No trailing slash. In production, set this to your deployed backend's
# API URL, e.g. https://api.yourdomain.com/api - the value below is only
# correct for local dev against a locally-running backend.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
